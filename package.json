{
  "name": "chaos-lab",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/app.js && node --test --test-force-exit tests/engine.test.js tests/repository.test.js tests/server.test.js tests/exporters.test.js && node tests/ui-smoke.mjs",
    "start": "node scripts/server.cjs",
    "dev": "node scripts/server.cjs",
    "package": "node scripts/package-release.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:exports": "node scripts/export-fixtures.mjs && python tests/export-python.py .export-test",
    "test:binary": "node scripts/smoke-binary.mjs"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.37.4",
    "lucide": "^0.468.0",
    "nerdamer": "^1.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.56.1",
    "postject": "^1.0.0-alpha.6"
  },
  "description": "Symbolic probability systems studio",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
